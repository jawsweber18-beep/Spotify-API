# Copy this file to .env and fill in your own values.

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URI configured on your Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/auth/callback

# Where the React dev server runs (used for CORS + post-login redirect)
CLIENT_URL=http://127.0.0.1:5173

# Long random string used to sign the session cookie
SESSION_SECRET=change_this_to_a_long_random_string

PORT=8888
